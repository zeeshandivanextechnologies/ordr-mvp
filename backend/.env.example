PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordr_db
DB_USER=postgres
DB_PASSWORD=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Encrypts stored Gmail OAuth tokens (optional; falls back to a key derived from JWT_SECRET).
# Do not change it after tokens are saved, or users will need to reconnect Gmail.
TOKEN_ENCRYPTION_KEY=

# Automatic Gmail inbox scan interval in minutes (default 15, 0 = off)
GMAIL_AUTO_SCAN_MINUTES=15

# AI (OpenAI / Gemini)
AI_PROVIDER=openai
AI_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Razorpay (plan payments). Use test keys from the Razorpay dashboard for testing.
# Webhook URL: <BACKEND_URL>/api/billing/webhook  (events: payment.captured, order.paid)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invoice seller details (without a GSTIN a "Payment Receipt" is issued instead of a "Tax Invoice")
INVOICE_SELLER_NAME=ORDR
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_GSTIN=
GST_RATE=18

# Only for the one-off scripts fix_neon.js / migrate_to_neon.js (never hard-code passwords in code)
LOCAL_DATABASE_URL=
NEON_DATABASE_URL=
